{% extends 'admin/base.html.twig' %}

{% block title %}Utilisateurs - Administration{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block admin_content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-neutral-900">Utilisateurs</h1>
    <p class="text-neutral-600 mt-1">Gérez tous les utilisateurs du blog</p>
</div>

<div class="bg-white rounded-xl shadow-md overflow-hidden">
    <table class="min-w-full divide-y divide-neutral-200">
        <thead class="bg-neutral-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Utilisateur</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Téléphone</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Rôle</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Inscrit le</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-neutral-200">
            {% for user in users %}
                <tr class="hover:bg-neutral-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-500 to-rose-500 flex items-center justify-center text-white font-bold">
                                {{ user.firstName|slice(0, 1)|upper }}
                            </div>
                            <span class="font-medium text-neutral-900">{{ user.firstName }} {{ user.lastName }}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-neutral-600 text-sm">{{ user.email }}</td>
                    <td class="px-6 py-4 text-neutral-500 text-sm">{{ user.phone ?? '-' }}</td>
                    <td class="px-6 py-4">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="px-2 py-1 bg-orange-100 text-orange-700 text-xs font-medium rounded">Admin</span>
                        {% else %}
                            <span class="px-2 py-1 bg-neutral-100 text-neutral-600 text-xs font-medium rounded">Membre</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-neutral-500 text-sm">
                        {{ user.createdAt|date('d/m/Y') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-neutral-500">
                        <p class="text-lg font-medium">Aucun utilisateur</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}