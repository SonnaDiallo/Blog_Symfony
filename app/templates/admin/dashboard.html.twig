{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord - Administration{% endblock %}

{% block admin_content %}
<div class="mb-8">
    <h1 class="text-3xl font-bold text-neutral-900">Tableau de bord</h1>
    <p class="text-neutral-600 mt-2">Bienvenue dans l'espace d'administration</p>
</div>

{# Statistiques en cards #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    {# Articles #}
    <div class="bg-gradient-to-br from-orange-500 to-amber-500 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-orange-100 text-sm font-medium">Articles</p>
                <p class="text-3xl font-bold mt-2">{{ stats.totalPosts }}</p>
            </div>
            <div class="bg-white/20 rounded-full p-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
        </div>
    </div>

    {# Utilisateurs #}
    <div class="bg-gradient-to-br from-amber-500 to-orange-500 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-amber-100 text-sm font-medium">Utilisateurs</p>
                <p class="text-3xl font-bold mt-2">{{ stats.totalUsers }}</p>
            </div>
            <div class="bg-white/20 rounded-full p-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </div>
        </div>
    </div>

    {# Catégories #}
    <div class="bg-gradient-to-br from-rose-500 to-orange-500 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-rose-100 text-sm font-medium">Catégories</p>
                <p class="text-3xl font-bold mt-2">{{ stats.totalCategories }}</p>
            </div>
            <div class="bg-white/20 rounded-full p-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
            </div>
        </div>
    </div>

    {# Commentaires #}
    <div class="bg-gradient-to-br from-orange-400 to-rose-500 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-orange-100 text-sm font-medium">Commentaires</p>
                <p class="text-3xl font-bold mt-2">{{ stats.totalComments }}</p>
            </div>
            <div class="bg-white/20 rounded-full p-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {# Articles récents #}
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-neutral-900">Articles récents</h2>
            <a href="{{ path('admin_posts') }}" class="text-orange-600 hover:text-orange-700 text-sm font-medium">
                Voir tout →
            </a>
        </div>
        <div class="space-y-3">
            {% for post in recentPosts %}
                <div class="flex items-center gap-3 p-3 hover:bg-neutral-50 rounded-lg transition-colors">
                    {% if post.image %}
                        <img src="{{ asset('uploads/' ~ post.image) }}" alt="{{ post.title }}" class="w-12 h-12 object-cover rounded-lg">
                    {% else %}
                        <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-amber-500 rounded-lg"></div>
                    {% endif %}
                    <div class="flex-1">
                        <p class="font-medium text-neutral-900 text-sm">{{ post.title }}</p>
                        <p class="text-xs text-neutral-500">{{ post.formattedDate }}</p>
                    </div>
                </div>
            {% else %}
                <p class="text-neutral-500 text-center py-4">Aucun article</p>
            {% endfor %}
        </div>
    </div>

    {# Utilisateurs récents #}
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-neutral-900">Utilisateurs récents</h2>
            <a href="{{ path('admin_users') }}" class="text-orange-600 hover:text-orange-700 text-sm font-medium">
                Voir tout →
            </a>
        </div>
        <div class="space-y-3">
            {% for user in recentUsers %}
                <div class="flex items-center gap-3 p-3 hover:bg-neutral-50 rounded-lg transition-colors">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-500 to-rose-500 flex items-center justify-center text-white font-bold">
                        {{ user.firstName|slice(0, 1)|upper }}
                    </div>
                    <div class="flex-1">
                        <p class="font-medium text-neutral-900 text-sm">{{ user.firstName }} {{ user.lastName }}</p>
                        <p class="text-xs text-neutral-500">{{ user.email }}</p>
                    </div>
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="px-2 py-1 bg-orange-100 text-orange-700 text-xs font-medium rounded">Admin</span>
                    {% endif %}
                </div>
            {% else %}
                <p class="text-neutral-500 text-center py-4">Aucun utilisateur</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}