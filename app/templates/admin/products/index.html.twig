{% extends 'admin/base.html.twig' %}

{% block title %}Produits - Administration{% endblock %}
{% block page_title %}Gestion des produits{% endblock %}

{% block admin_content %}
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-neutral-900">Produits</h1>
        <p class="text-neutral-600 mt-1">Gérez les produits de la boutique</p>
    </div>
    <a href="{{ path('admin_product_new') }}" 
       class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600 transition-all shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nouveau produit
    </a>
</div>

<div class="bg-white rounded-xl shadow-md overflow-hidden">
    <table class="min-w-full divide-y divide-neutral-200">
        <thead class="bg-neutral-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Produit</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Prix</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Stock</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Catégorie</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Statut</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-neutral-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-neutral-200">
            {% for product in products %}
                <tr class="hover:bg-neutral-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            {% if product.image %}
                                <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}" class="w-12 h-12 object-cover rounded-lg">
                            {% else %}
                                <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-amber-500 rounded-lg flex items-center justify-center">
                                    <span class="text-white text-xl">🛍️</span>
                                </div>
                            {% endif %}
                            <span class="font-medium text-neutral-900">{{ product.name }}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-neutral-900 font-semibold">{{ product.formattedPrice }}</td>
                    <td class="px-6 py-4">
                        {% if product.stock > 0 %}
                            <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded">{{ product.stock }} en stock</span>
                        {% else %}
                            <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded">Rupture</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-neutral-500 text-sm">{{ product.category ? product.category.name : '-' }}</td>
                    <td class="px-6 py-4">
                        {% if product.isActive %}
                            <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded">Actif</span>
                        {% else %}
                            <span class="px-2 py-1 bg-neutral-100 text-neutral-600 text-xs font-medium rounded">Inactif</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_product_edit', {id: product.id}) }}" 
                               class="text-orange-600 hover:text-orange-900" title="Modifier">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </a>
                            <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}" 
                                  onsubmit="return confirm('Supprimer ce produit ?');" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                <button type="submit" class="text-red-600 hover:text-red-900" title="Supprimer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-neutral-500">
                        <p class="text-lg font-medium">Aucun produit</p>
                        <p class="text-sm mt-1">Créez votre premier produit</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
