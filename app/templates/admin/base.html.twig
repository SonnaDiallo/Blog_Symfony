{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    {# Sidebar #}
    <aside class="fixed top-0 left-0 z-40 w-64 h-screen bg-gradient-to-b from-orange-500 to-amber-600 shadow-xl">
        <div class="h-full px-3 py-4 overflow-y-auto">
            {# Logo #}
            <div class="flex items-center mb-6 px-3">
                <h1 class="text-2xl font-bold text-white">Admin Panel</h1>
            </div>

            {# Navigation #}
            <ul class="space-y-2">
                <li>
                    <a href="{{ path('admin_dashboard') }}" 
                       class="flex items-center p-3 text-white rounded-lg hover:bg-white/10 transition-colors group
                              {% if app.request.get('_route') == 'admin_dashboard' %}bg-white/20{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span>Tableau de bord</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('admin_posts') }}" 
                       class="flex items-center p-3 text-white rounded-lg hover:bg-white/10 transition-colors group
                              {% if app.request.get('_route') starts with 'admin_post' %}bg-white/20{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>Articles</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('admin_categories') }}" 
                       class="flex items-center p-3 text-white rounded-lg hover:bg-white/10 transition-colors group
                              {% if app.request.get('_route') starts with 'admin_categor' %}bg-white/20{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                        <span>Catégories</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('admin_users') }}" 
                       class="flex items-center p-3 text-white rounded-lg hover:bg-white/10 transition-colors group
                              {% if app.request.get('_route') starts with 'admin_user' %}bg-white/20{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span>Utilisateurs</span>
                    </a>
                </li>

                <li class="pt-4 mt-4 border-t border-white/20">
                    <a href="{{ path('app_blog_index') }}" 
                       class="flex items-center p-3 text-white rounded-lg hover:bg-white/10 transition-colors group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        <span>Retour au site</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_logout') }}" 
                       class="flex items-center p-3 text-white rounded-lg hover:bg-red-500 transition-colors group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        <span>Déconnexion</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    {# Main Content #}
    <div class="ml-64">
        {# Top Bar #}
        <header class="bg-white shadow-sm sticky top-0 z-30">
            <div class="flex items-center justify-between px-8 py-4">
                <div>
                    <h2 class="text-xl font-semibold text-neutral-800">{% block page_title %}Administration{% endblock %}</h2>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-sm text-neutral-600">
                        {{ app.user.firstName }} {{ app.user.lastName }}
                    </span>
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-500 to-amber-500 flex items-center justify-center text-white font-bold">
                        {{ app.user.firstName|slice(0, 1)|upper }}
                    </div>
                </div>
            </div>
        </header>

        {# Flash Messages #}
        <div class="px-8 py-4">
            {% for message in app.flashes('success') %}
                <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    {{ message }}
                </div>
            {% endfor %}
        </div>

        {# Page Content #}
        <main class="px-8 py-6">
            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}