{% extends 'base.html.twig' %}

{% block title %}Blog - Mon Blog{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-500 via-purple-500 to-purple-600">
    
    {# Navigation #}
    <nav class="bg-white/95 backdrop-blur-sm shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_home') }}" class="text-primary-600 font-semibold text-xl">Mon Blog</a>
                </div>
                
                <div class="flex items-center gap-2 sm:gap-4">
                    <a href="{{ path('app_home') }}" 
                       class="inline-flex items-center gap-2 px-4 py-2 text-neutral-700 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span class="hidden sm:inline">Accueil</span>
                    </a>
                    
                    {% if app.user %}
                        {# Si l'utilisateur est connecté #}
                        
                        {% if is_granted('ROLE_ADMIN') %}
                            {# Bouton "Nouvel article" UNIQUEMENT pour les ADMIN #}
                            <a href="{{ path('app_blog_new') }}" 
                               class="inline-flex items-center gap-2 px-4 py-2 bg-primary-500 text-white hover:bg-primary-600 rounded-lg transition-all shadow-md hover:shadow-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                <span class="hidden sm:inline">Nouvel article</span>
                            </a>
                        {% endif %}
                        
                        <span class="text-neutral-700 px-4 py-2">
                            Bonjour {{ app.user.firstName ?? app.user.email }} !
                        </span>
                        
                        <a href="{{ path('app_logout') }}" 
                           class="inline-flex items-center gap-2 px-4 py-2 text-neutral-700 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span class="hidden sm:inline">Déconnexion</span>
                        </a>
                    {% else %}
                        {# Si l'utilisateur n'est PAS connecté #}
                        
                        <a href="{{ path('app_register') }}" 
                           class="inline-flex items-center gap-2 px-4 py-2 text-neutral-700 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                            </svg>
                            <span class="hidden sm:inline">S'inscrire</span>
                        </a>
                        
                        <a href="{{ path('app_login') }}" 
                           class="inline-flex items-center gap-2 px-4 py-2 bg-primary-500 text-white hover:bg-primary-600 rounded-lg transition-all shadow-md hover:shadow-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                            </svg>
                            <span class="hidden sm:inline">Se connecter</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    {# Header "MON BLOG" avec IMAGE en arrière-plan #}
    <header class="relative text-white py-32 overflow-hidden">
        
        {# Image de fond + overlay sombre #}
        <div class="absolute inset-0">
            {# Votre image.png en arrière-plan #}
            <img src="{{ asset('images/image.png') }}" 
                 alt="Background" 
                 class="w-full h-full object-cover opacity-80">
            {# Overlay sombre pour que le texte soit lisible #}
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-purple-900/30"></div>
        </div>
        
        {# Formes décoratives #}
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute top-20 right-10 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 left-20 w-80 h-80 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute top-1/2 left-1/3 w-64 h-64 bg-white/5 rounded-full blur-2xl"></div>
        </div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-white mb-6 tracking-tight" style="font-size: clamp(3rem, 8vw, 5.5rem); font-weight: 900; line-height: 1.1;">
                MON BLOG
            </h1>
            <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto">
                Découvrez nos derniers articles sur le développement, le design, l'architecture et bien plus encore.
            </p>
        </div>
    </header>

    {# Contenu principal #}
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 bg-green-500/90 backdrop-blur-sm border border-green-400 text-white rounded-lg">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 p-4 bg-red-500/90 backdrop-blur-sm border border-red-400 text-white rounded-lg">
                {{ message }}
            </div>
        {% endfor %}

        {# Section articles #}
        <div class="p-8">
            <h2 class="text-white mb-8 text-3xl font-bold drop-shadow-lg">Tous nos articles</h2>
            
            {% if blog_posts|length > 0 %}
                <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {% for post in blog_posts %}
                        <article class="group bg-white/10 backdrop-blur-sm rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-white/20">
                            
                            {# Image #}
                            <a href="{{ path('app_blog_show', {id: post.id}) }}" class="block relative h-48 overflow-hidden">
                                {% if post.image %}
                                    <img src="{{ asset('uploads/' ~ post.image) }}"
                                         alt="{{ post.title }}" 
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                {% else %}
                                    <div class="w-full h-full bg-gradient-to-br from-blue-400 via-purple-400 to-purple-500 flex items-center justify-center">
                                        <span class="text-white text-xl">📝</span>
                                    </div>
                                {% endif %}
                                
                                {# Badge catégorie #}
                                {% if post.category %}
                                    <span class="absolute top-3 right-3 px-3 py-1 bg-white/90 backdrop-blur-sm text-primary-600 rounded-full text-xs font-semibold shadow-md">
                                        {{ post.category.name }}
                                    </span>
                                {% endif %}
                            </a>

                            {# Contenu #}
                            <div class="p-6">
                                {# Titre #}
                                <a href="{{ path('app_blog_show', {id: post.id}) }}">
                                    <h3 class="text-white mb-3 font-bold text-xl group-hover:text-white/80 transition-colors">
                                        {{ post.title }}
                                    </h3>
                                </a>

                                {# Extrait - version avec filtre Twig #}
                                <p class="text-white/90 text-sm mb-4 line-clamp-2">
                                    {{ post.content|striptags|slice(0, 100) }}...
                                </p>

                                {# Métadonnées #}
                                <div class="flex items-center justify-between text-xs text-white/80 mb-4">
                                    <span class="font-medium">
                                        {% if post.user %}
                                            {{ post.user.firstName ?? post.user.email }}
                                        {% else %}
                                            Admin Blog
                                        {% endif %}
                                    </span>
                                    <div class="flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span>
                                            {% if post.readingTime %}
                                                {{ post.readingTime }} min
                                            {% else %}
                                                3 min
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>

                                {# Boutons d'action #}
                                <div class="flex items-center justify-between pt-4 border-t border-white/30">
                                    {# Bouton "Lire la suite" #}
                                    <a href="{{ path('app_blog_show', {id: post.id}) }}" 
                                       class="inline-flex items-center gap-2 text-white font-semibold hover:gap-3 transition-all text-sm">
                                        Lire la suite
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                        </svg>
                                    </a>
                                    
                                    {# Boutons d'administration #}
                                    {% if app.user and (is_granted('ROLE_ADMIN') or post.user == app.user) %}
                                        <div class="flex items-center gap-2">
                                            {# Bouton Modifier #}
                                            <a href="{{ path('app_blog_edit', {id: post.id}) }}" 
                                               class="inline-flex items-center justify-center w-8 h-8 bg-blue-500/80 hover:bg-blue-600 text-white rounded-lg transition-all"
                                               title="Modifier">
                                                ✏️
                                            </a>
                                            
                                            {# Bouton Supprimer #}
                                            <form method="post" 
                                                  action="{{ path('app_blog_delete', {id: post.id}) }}" 
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');"
                                                  class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                                <button type="submit" 
                                                        class="inline-flex items-center justify-center w-8 h-8 bg-red-500/80 hover:bg-red-600 text-white rounded-lg transition-all"
                                                        title="Supprimer">
                                                    🗑️
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-16">
                    <div class="inline-block p-8 bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20">
                        <div class="text-6xl mb-4">📝</div>
                        <p class="text-white text-xl mb-6">Aucun article pour le moment.</p>
                        {% if app.user and is_granted('ROLE_USER') %}
                            <a href="{{ path('app_blog_new') }}" 
                               class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary-600 rounded-lg hover:bg-white/90 font-semibold transition-all shadow-lg">
                                ✨ Créer le premier article
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </main>
    
    {# Footer #}
    <footer class="bg-white/20 backdrop-blur-sm text-white py-12 mt-16 border-t border-white/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-white/90 text-lg">
                © {{ 'now'|date('Y') }} Mon Blog. Tous droits réservés.
            </p>
        </div>
    </footer>
</div>
{% endblock %}