{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-orange-50 via-white to-amber-50">
    
    {# Navigation #}
    <nav class="shadow-md sticky top-0 z-40" style="background: linear-gradient(to right, #f97316, #f59e0b);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <a href="{{ path('app_blog_index') }}" class="text-white font-bold text-xl">Mon Blog</a>
                <div class="flex items-center gap-4">
                    <a href="{{ path('app_shop_index') }}" class="text-white hover:bg-white/20 px-4 py-2 rounded-lg transition-all">← Continuer mes achats</a>
                </div>
            </div>
        </div>
    </nav>

    {# Header #}
    <header class="text-white py-12 shadow-lg" style="background: linear-gradient(to right, #f97316, #f59e0b);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-4xl font-bold">Mon Panier</h1>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12">
        
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 bg-green-500 text-white rounded-lg">{{ message }}</div>
        {% endfor %}

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            {% if items|length > 0 %}
                <div class="divide-y divide-gray-200">
                    {% for item in items %}
                        <div class="p-6 flex items-center gap-6">
                            {# Image #}
                            <div class="w-24 h-24 flex-shrink-0">
                                {% if item.post.image %}
                                    <img src="{{ asset('uploads/' ~ item.post.image) }}" alt="{{ item.post.title }}" class="w-full h-full object-cover rounded-lg">
                                {% else %}
                                    <div class="w-full h-full bg-gradient-to-br from-orange-400 to-amber-500 rounded-lg flex items-center justify-center">
                                        <span class="text-white text-2xl">🛍️</span>
                                    </div>
                                {% endif %}
                            </div>
                            
                            {# Détails #}
                            <div class="flex-1">
                                <a href="{{ path('app_blog_show', {id: item.post.id}) }}" class="font-semibold text-neutral-900 hover:text-orange-600">{{ item.post.title }}</a>
                                <p class="text-sm text-neutral-500">{{ item.post.formattedPrice }} / unité</p>
                            </div>
                            
                            {# Quantité #}
                            <form action="{{ path('app_cart_update', {id: item.id}) }}" method="post" class="flex items-center gap-2">
                                <input type="number" name="quantity" value="{{ item.quantity }}" min="1" 
                                       class="w-20 px-3 py-2 border border-gray-300 rounded-lg text-center"
                                       onchange="this.form.submit()">
                            </form>
                            
                            {# Total ligne #}
                            <div class="text-right">
                                <p class="font-bold text-orange-600">{{ item.formattedTotal }}</p>
                            </div>
                            
                            {# Supprimer #}
                            <form action="{{ path('app_cart_remove', {id: item.id}) }}" method="post">
                                <button type="submit" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
                
                {# Total et actions #}
                <div class="p-6 bg-gray-50 border-t border-gray-200">
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-xl font-semibold text-neutral-900">Total</span>
                        <span class="text-2xl font-bold text-orange-600">{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>
                    
                    <div class="flex gap-4">
                        <form action="{{ path('app_cart_clear') }}" method="post" class="flex-1">
                            <button type="submit" class="w-full px-6 py-3 border-2 border-neutral-300 text-neutral-700 rounded-lg hover:bg-neutral-100 transition-colors font-semibold">
                                Vider le panier
                            </button>
                        </form>
                        <button class="flex-1 px-6 py-3 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600 transition-all font-semibold">
                            Commander
                        </button>
                    </div>
                </div>
            {% else %}
                <div class="p-12 text-center">
                    <div class="text-6xl mb-4">🛒</div>
                    <p class="text-xl text-neutral-500 mb-6">Votre panier est vide</p>
                    <a href="{{ path('app_shop_index') }}" class="inline-block px-6 py-3 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600 transition-all font-semibold">
                        Découvrir nos produits
                    </a>
                </div>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
