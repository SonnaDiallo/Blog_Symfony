{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} - Mon Blog{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50 to-rose-50">
    
    {# Navigation #}
    <nav class="bg-white/95 backdrop-blur-sm shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_home') }}" class="text-orange-600 font-semibold text-xl">Mon Blog</a>
                </div>
                
                <div class="flex items-center gap-2 sm:gap-4">
                    <a href="{{ path('app_blog_index') }}" 
                       class="inline-flex items-center gap-2 px-4 py-2 text-neutral-700 hover:text-orange-600 hover:bg-orange-50 rounded-lg transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        <span class="hidden sm:inline">Retour aux articles</span>
                    </a>
                    
                    {% if app.user and (is_granted('ROLE_ADMIN') or post.user == app.user) %}
                        <a href="{{ path('app_blog_edit', {id: post.id}) }}" 
                           class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white hover:from-orange-600 hover:to-amber-600 rounded-lg transition-all shadow-md hover:shadow-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            <span class="hidden sm:inline">Modifier</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    {# Contenu principal #}
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 bg-gradient-to-r from-emerald-500 to-green-500 backdrop-blur-sm border border-emerald-400 text-white rounded-lg shadow-lg">
                {{ message }}
            </div>
        {% endfor %}

        {# Article #}
        <article class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            
            {# Image de couverture #}
            {% if post.image %}
                <div class="relative h-96 overflow-hidden">
                    <img src="{{ asset('images/' ~ post.image) }}" 
                         alt="{{ post.title }}" 
                         class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                    
                    {# Catégorie #}
                    {% if post.category %}
                        <span class="absolute top-6 right-6 px-4 py-2 bg-gradient-to-r from-orange-500 to-rose-500 text-white rounded-full font-semibold shadow-lg">
                            {{ post.category.name }}
                        </span>
                    {% endif %}
                </div>
            {% else %}
                {# Pas d'image #}
                <div class="relative h-64 overflow-hidden bg-gradient-to-br from-orange-400 via-amber-400 to-rose-500">
                    <div class="w-full h-full flex items-center justify-center">
                        <div class="text-center text-white">
                            <div class="text-6xl mb-4">📝</div>
                            <p class="text-xl font-semibold">{{ post.title }}</p>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Contenu de l'article #}
            <div class="p-8 md:p-12">
                {# En-tête #}
                <div class="mb-8">
                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">
                        {{ post.title }}
                    </h1>
                    
                    <div class="flex flex-wrap items-center gap-4 text-gray-600">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="font-medium">
                                {% if post.user %}
                                    {{ post.user.firstName ?? post.user.email }}
                                {% else %}
                                    Admin Blog
                                {% endif %}
                            </span>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span>{{ post.createdAt|date('d F Y') }}</span>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>
                                {% if post.readingTime %}
                                    {{ post.readingTime }} min de lecture
                                {% else %}
                                    3 min de lecture
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>

                {# Contenu #}
                <div class="prose prose-lg max-w-none text-gray-700">
                    {{ post.content|raw }}
                </div>

                {# Actions #}
                <div class="mt-12 pt-8 border-t border-gray-200">
                    <div class="flex flex-wrap gap-4">
                        <a href="{{ path('app_blog_index') }}" 
                           class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600 transition-all shadow-md hover:shadow-lg font-semibold">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                            Retour aux articles
                        </a>
                        
                        {% if app.user and (is_granted('ROLE_ADMIN') or post.user == app.user) %}
                            <a href="{{ path('app_blog_edit', {id: post.id}) }}" 
                               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-rose-500 to-pink-500 text-white rounded-lg hover:from-rose-600 hover:to-pink-600 transition-all shadow-md hover:shadow-lg font-semibold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Modifier l'article
                            </a>
                            
                            <form method="post" 
                                  action="{{ path('app_blog_delete', {id: post.id}) }}" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');"
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button type="submit" 
                                        class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-rose-500 text-white rounded-lg hover:from-red-600 hover:to-rose-600 transition-all shadow-md hover:shadow-lg font-semibold">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Supprimer l'article
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </article>
    </main>
    
    {# Footer #}
    <footer class="bg-white/80 backdrop-blur-sm text-gray-700 py-12 mt-16 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-gray-600 text-lg">
                © {{ 'now'|date('Y') }} Mon Blog. Tous droits réservés.
            </p>
        </div>
    </footer>
</div>
{% endblock %}