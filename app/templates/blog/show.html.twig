{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} - Mon Blog{% endblock %}

{% block javascripts %}
<script>
async function toggleLike(postId) {
    {% if not app.user %}
        window.location.href = '{{ path('app_login') }}';
        return;
    {% endif %}
    
    try {
        const response = await fetch(`/like/post/${postId}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            const btn = document.getElementById('like-btn');
            const icon = document.getElementById('like-icon');
            const count = document.getElementById('likes-count');
            
            count.textContent = data.likesCount;
            
            if (data.liked) {
                btn.classList.remove('bg-gray-100', 'text-gray-600');
                btn.classList.add('bg-rose-100', 'text-rose-600');
                icon.setAttribute('fill', 'currentColor');
            } else {
                btn.classList.remove('bg-rose-100', 'text-rose-600');
                btn.classList.add('bg-gray-100', 'text-gray-600');
                icon.setAttribute('fill', 'none');
            }
        }
    } catch (error) {
        console.error('Erreur:', error);
    }
}
</script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-orange-50 via-white to-amber-50 overflow-hidden">
    
    {# Navigation avec animation #}
    <nav class="shadow-md sticky top-0 z-40 relative overflow-hidden" style="background: linear-gradient(to right, #f97316, #f59e0b);">
        {# Particules dans la nav #}
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="particle absolute w-2 h-2 bg-white/10 rounded-full animate-float" style="top: 30%; left: 5%;"></div>
            <div class="particle absolute w-3 h-3 bg-white/10 rounded-full animate-float" style="top: 50%; right: 10%; animation-delay: 1s;"></div>
        </div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_blog_index') }}" class="text-white font-bold text-xl hover-scale inline-block">Mon Blog</a>
                </div>
                
                <div class="flex items-center gap-2 sm:gap-4">
                    <a href="{{ path('app_blog_index') }}" 
                       class="group inline-flex items-center gap-2 px-4 py-2 text-white hover:bg-white/20 rounded-lg transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        <span class="hidden sm:inline">Retour aux articles</span>
                    </a>
                    
                    {% if app.user and (is_granted('ROLE_ADMIN') or post.user == app.user) %}
                        <a href="{{ path('app_blog_edit', {id: post.id}) }}" 
                           class="group inline-flex items-center gap-2 px-4 py-2 bg-white text-orange-600 hover:bg-orange-50 rounded-lg transition-all shadow-md hover:shadow-lg font-semibold hover-lift">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            <span class="hidden sm:inline">Modifier</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    {# Contenu principal #}
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 bg-gradient-to-r from-emerald-500 to-green-500 backdrop-blur-sm border border-emerald-400 text-white rounded-lg shadow-lg">
                {{ message }}
            </div>
        {% endfor %}

        {# Article #}
        <article class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 animate-on-load animate-fade-in-up hover-lift">
            
            {# Image de couverture avec animations #}
            {% if post.image %}
                <div class="relative h-96 overflow-hidden group">
                    <img src="{{ asset('uploads/' ~ post.image) }}" 
                         alt="{{ post.title }}" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/20 to-transparent"></div>
                    
                    {# Particules décoratives #}
                    <div class="absolute inset-0 overflow-hidden pointer-events-none">
                        <div class="particle absolute w-3 h-3 bg-white/20 rounded-full animate-float" style="top: 20%; left: 10%;"></div>
                        <div class="particle absolute w-4 h-4 bg-orange-400/20 rounded-full animate-float" style="top: 60%; right: 15%; animation-delay: 1s;"></div>
                    </div>
                    
                    {# Catégorie #}
                    {% if post.category %}
                        <span class="absolute top-6 right-6 px-4 py-2 bg-gradient-to-r from-orange-500 to-rose-500 text-white rounded-full font-semibold shadow-lg animate-bounce-subtle">
                            {{ post.category.name }}
                        </span>
                    {% endif %}
                </div>
            {% else %}
                {# Pas d'image - avec animation #}
                <div class="relative h-64 overflow-hidden bg-gradient-to-br from-orange-400 via-amber-400 to-rose-500 animate-gradient" style="background-size: 200% 200%;">
                    {# Particules #}
                    <div class="absolute inset-0 overflow-hidden pointer-events-none">
                        <div class="particle absolute w-4 h-4 bg-white/20 rounded-full animate-float" style="top: 20%; left: 15%;"></div>
                        <div class="particle absolute w-6 h-6 bg-white/15 rounded-full animate-float" style="top: 60%; right: 20%; animation-delay: 1s;"></div>
                        <div class="particle absolute w-3 h-3 bg-white/25 rounded-full animate-float" style="bottom: 30%; left: 40%; animation-delay: 2s;"></div>
                    </div>
                    <div class="w-full h-full flex items-center justify-center relative z-10">
                        <div class="text-center text-white">
                            <div class="text-6xl mb-4 animate-bounce-subtle">📝</div>
                            <p class="text-xl font-semibold">{{ post.title }}</p>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Contenu de l'article #}
            <div class="p-8 md:p-12">
                {# En-tête #}
                <div class="mb-8">
                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">
                        {{ post.title }}
                    </h1>
                    
                    <div class="flex flex-wrap items-center gap-4 text-gray-600">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="font-medium">
                                {% if post.user %}
                                    {{ post.user.firstName ?? post.user.email }}
                                {% else %}
                                    Admin Blog
                                {% endif %}
                            </span>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span>{{ post.createdAt|date('d F Y') }}</span>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>
                                {% if post.readingTime %}
                                    {{ post.readingTime }} min de lecture
                                {% else %}
                                    3 min de lecture
                                {% endif %}
                            </span>
                        </div>
                        
                        {# Bouton Like #}
                        <button id="like-btn" 
                                onclick="toggleLike({{ post.id }})"
                                class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all {% if app.user and post.isLikedByUser(app.user) %}bg-rose-100 text-rose-600{% else %}bg-gray-100 text-gray-600 hover:bg-rose-50 hover:text-rose-500{% endif %}">
                            <svg id="like-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" 
                                 fill="{% if app.user and post.isLikedByUser(app.user) %}currentColor{% else %}none{% endif %}" 
                                 viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                            </svg>
                            <span id="likes-count">{{ post.likesCount }}</span>
                        </button>
                    </div>
                </div>

                {# Contenu #}
                <div class="prose prose-lg max-w-none text-gray-700">
                    {{ post.content|raw }}
                </div>

                {# Section Achat - si l'article est en vente #}
                {% if post.price and post.stock > 0 %}
                <div class="mt-8 p-6 bg-gradient-to-r from-orange-50 to-amber-50 rounded-xl border border-orange-200">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <div>
                            <p class="text-3xl font-bold text-orange-600">{{ post.price|number_format(2, ',', ' ') }} €</p>
                            <p class="text-sm text-gray-600 mt-1">
                                <span class="inline-flex items-center gap-1 text-green-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    {{ post.stock }} en stock
                                </span>
                            </p>
                        </div>
                        <form action="{{ path('app_cart_add', {id: post.id}) }}" method="POST" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_add' ~ post.id) }}">
                            <button type="submit" 
                               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-lg hover:from-green-600 hover:to-emerald-600 transition-all shadow-lg hover:shadow-xl font-semibold cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                Ajouter au panier
                            </button>
                        </form>
                    </div>
                </div>
                {% elseif post.price and post.stock == 0 %}
                <div class="mt-8 p-6 bg-gray-100 rounded-xl border border-gray-200">
                    <div class="flex items-center gap-4">
                        <p class="text-2xl font-bold text-gray-400 line-through">{{ post.price|number_format(2, ',', ' ') }} €</p>
                        <span class="px-3 py-1 bg-red-100 text-red-600 rounded-full text-sm font-medium">Rupture de stock</span>
                    </div>
                </div>
                {% endif %}

                {# Actions #}
                <div class="mt-12 pt-8 border-t border-gray-200">
                    <div class="flex flex-wrap gap-4">
                        <a href="{{ path('app_blog_index') }}" 
                           class="group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600 transition-all shadow-md hover:shadow-lg font-semibold hover-lift hover-glow">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                            Retour aux articles
                        </a>
                        
                        {% if app.user and (is_granted('ROLE_ADMIN') or post.user == app.user) %}
                            <a href="{{ path('app_blog_edit', {id: post.id}) }}" 
                               class="group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-rose-500 to-pink-500 text-white rounded-lg hover:from-rose-600 hover:to-pink-600 transition-all shadow-md hover:shadow-lg font-semibold hover-lift">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Modifier l'article
                            </a>
                            
                            <form method="post" 
                                  action="{{ path('app_blog_delete', {id: post.id}) }}" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');"
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button type="submit" 
                                        class="group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-rose-500 text-white rounded-lg hover:from-red-600 hover:to-rose-600 transition-all shadow-md hover:shadow-lg font-semibold hover-lift">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Supprimer l'article
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </article>
    </main>
    
    {# Footer #}
    <footer class="text-white py-12 mt-16 shadow-lg" style="background: linear-gradient(to right, #f97316, #f59e0b);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <p class="text-white text-lg mb-4">
                    © {{ 'now'|date('Y') }} Mon Blog. Tous droits réservés.
                </p>
                <div class="flex justify-center gap-6">
                    <a href="{{ path('mentions_legales') }}" class="text-white/80 hover:text-white transition-colors">Mentions légales</a>
                    <a href="{{ path('contact') }}" class="text-white/80 hover:text-white transition-colors">Contact</a>
                    <a href="{{ path('a_propos') }}" class="text-white/80 hover:text-white transition-colors">À propos</a>
                </div>
            </div>
        </div>
    </footer>
</div>
{% endblock %}