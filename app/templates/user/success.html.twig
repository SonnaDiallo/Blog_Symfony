{% extends 'base.html.twig' %}

{% block title %}Profil enregistré{% endblock %}

{% block body %}
<div class="success-container">
    <div class="success-card">
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        
        <h2>Profil enregistré avec succès !</h2>
        
        <p>
            Vos informations ont été sauvegardées avec succès. 
            Vous pouvez maintenant profiter pleinement de votre expérience sur notre blog.
        </p>
        
        <div class="success-actions">
            <a href="{{ path('blog_index') }}" class="btn-primary">
                <i class="fas fa-newspaper"></i> Voir les articles
            </a>
            
            <a href="{{ path('blog_new') }}" class="btn-secondary">
                <i class="fas fa-pen"></i> Créer un article
            </a>
            
            <a href="{{ path('user_profile') }}" class="btn-secondary">
                <i class="fas fa-edit"></i> Modifier mon profil
            </a>
        </div>
    </div>
</div>
{% endblock %}