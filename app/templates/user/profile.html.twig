{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="profile-container">
    <div class="form-header">
        <h2><i class="fas fa-user-circle"></i> Mon Profil</h2>
        <p>Complétez vos informations personnelles pour personnaliser votre expérience.</p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div class="form-wrapper">
        {{ form_start(form, {'attr': {'class': 'user-form'}}) }}
        
        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.firstName) }}
                {{ form_widget(form.firstName, {'attr': {
                    'class': 'form-input',
                    'placeholder': 'Votre prénom'
                }}) }}
                {% if form.firstName.vars.errors %}
                    <div class="form-error">
                        {{ form_errors(form.firstName) }}
                    </div>
                {% endif %}
            </div>

            <div class="form-group">
                {{ form_label(form.lastName) }}
                {{ form_widget(form.lastName, {'attr': {
                    'class': 'form-input',
                    'placeholder': 'Votre nom de famille'
                }}) }}
                {% if form.lastName.vars.errors %}
                    <div class="form-error">
                        {{ form_errors(form.lastName) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {'attr': {
                'class': 'form-input',
                'placeholder': 'exemple@email.com'
            }}) }}
            {% if form.email.vars.errors %}
                <div class="form-error">
                    {{ form_errors(form.email) }}
                </div>
            {% endif %}
            <small class="form-hint">Nous ne partagerons jamais votre email avec des tiers.</small>
        </div>

        <div class="form-group">
            {{ form_label(form.phone) }}
            {{ form_widget(form.phone, {'attr': {
                'class': 'form-input',
                'placeholder': '+33 1 23 45 67 89'
            }}) }}
            {% if form.phone.vars.errors %}
                <div class="form-error">
                    {{ form_errors(form.phone) }}
                </div>
            {% endif %}
            <small class="form-hint">Optionnel - pour les notifications importantes.</small>
        </div>

        <div class="form-actions">
            <button type="submit" class="form-submit">
                <i class="fas fa-save"></i>
                Enregistrer mes informations
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}