{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-orange-50 via-white to-amber-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl p-8">
            {# Titre #}
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-neutral-900 mb-2">Mon Profil</h2>
                <p class="text-neutral-600">Complétez vos informations personnelles</p>
            </div>

            {% for message in app.flashes('error') %}
                <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.firstName, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-2'}}) }}
                    {{ form_widget(form.firstName, {'attr': {
                        'class': 'w-full px-4 py-3 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent',
                        'placeholder': 'Votre prénom'
                    }}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div>
                    {{ form_label(form.lastName, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-2'}}) }}
                    {{ form_widget(form.lastName, {'attr': {
                        'class': 'w-full px-4 py-3 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent',
                        'placeholder': 'Votre nom'
                    }}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>

            <div>
                {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-2'}}) }}
                {{ form_widget(form.email, {'attr': {
                    'class': 'w-full px-4 py-3 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent',
                    'placeholder': 'exemple@email.com'
                }}) }}
                {{ form_errors(form.email) }}
                <p class="mt-1 text-xs text-neutral-500">Nous ne partagerons jamais votre email.</p>
            </div>

            <div>
                {{ form_label(form.phone, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-2'}}) }}
                {{ form_widget(form.phone, {'attr': {
                    'class': 'w-full px-4 py-3 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent',
                    'placeholder': '+33 1 23 45 67 89'
                }}) }}
                {{ form_errors(form.phone) }}
                <p class="mt-1 text-xs text-neutral-500">Optionnel</p>
            </div>

            <button type="submit" 
                    class="w-full flex justify-center items-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600 transition-all shadow-md hover:shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Enregistrer
            </button>

            {{ form_end(form) }}

            {# Lien retour #}
            <div class="mt-6 text-center">
                <a href="{{ path('app_blog_index') }}" class="text-sm text-orange-600 hover:text-orange-700">
                    ← Retour au blog
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}