{% extends 'base.html.twig' %}

{% block title %}Bienvenue - Mon Blog{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-orange-50 via-white to-amber-50">
    {# Header orange #}
    <header class="text-white py-24 shadow-lg" style="background: linear-gradient(to right, #f97316, #f59e0b);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-5xl md:text-7xl font-bold mb-6">Bienvenue</h1>
            <p class="text-xl md:text-2xl text-white/90 max-w-2xl mx-auto">
                Découvrez notre blog de décoration
            </p>
        </div>
    </header>
    
    {# Contenu principal #}
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-orange-500 to-amber-500 rounded-full flex items-center justify-center mx-auto mb-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
            </div>
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Explorez nos articles</h2>
            <p class="text-gray-600 mb-8 max-w-xl mx-auto">
                Parcourez nos derniers articles sur la décoration intérieure, le design et l'aménagement de votre espace de vie.
            </p>
            <a href="{{ path('app_blog_index') }}" 
               class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg text-lg font-semibold shadow-lg hover:from-orange-600 hover:to-amber-600 hover:shadow-xl transition-all">
                Accéder au Blog
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
            </a>
        </div>
    </main>

    {# Footer #}
    <footer class="text-white py-12 shadow-lg" style="background: linear-gradient(to right, #f97316, #f59e0b);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <p class="text-white text-lg mb-4">
                    © {{ 'now'|date('Y') }} Mon Blog. Tous droits réservés.
                </p>
                <div class="flex justify-center gap-6">
                    <a href="{{ path('mentions_legales') }}" class="text-white/80 hover:text-white transition-colors">Mentions légales</a>
                    <a href="{{ path('contact') }}" class="text-white/80 hover:text-white transition-colors">Contact</a>
                    <a href="{{ path('a_propos') }}" class="text-white/80 hover:text-white transition-colors">À propos</a>
                </div>
            </div>
        </div>
    </footer>
</div>
{% endblock %}