{% extends 'base.html.twig' %}

{% block title %}Bienvenue - Mon Blog{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-500 via-purple-500 to-purple-600 relative overflow-hidden">
    
    {# Formes décoratives en arrière-plan #}
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-20 right-10 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 left-20 w-80 h-80 bg-white/20 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/3 w-64 h-64 bg-white/10 rounded-full blur-2xl"></div>
    </div>
    
    {# Contenu principal #}
    <div class="relative z-10 text-center px-4">
        <h1 class="text-white mb-6 tracking-tight" style="font-size: clamp(3rem, 8vw, 5.5rem); font-weight: 900; line-height: 1.1;">
            Bienvenue
        </h1>
        
        <p class="text-xl md:text-2xl text-white/90 max-w-2xl mx-auto mb-12">
            Découvrez notre blog de décoration
        </p>
        
        <a href="{{ path('app_blog_index') }}" 
           class="inline-flex items-center gap-2 px-8 py-4 bg-white text-blue-600 rounded-full text-lg font-semibold shadow-2xl hover:shadow-3xl hover:scale-105 transition-all duration-300">
            Accéder au Blog
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
        </a>
    </div>
</div>
{% endblock %}